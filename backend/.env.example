# Copy this file to .env and fill in the values. Never commit .env.

# Neon dashboard → your project → Connect → copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Websites allowed to call this API (comma-separated, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

PORT=3000

# Google Cloud → APIs & Services → Credentials → API key (with YouTube Data API v3 enabled)
# Needed only for "Import YouTube playlist".
YOUTUBE_API_KEY=
